<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- GEDEELDE SKAKELS maak die app oop, nie die blaaier nie.

                 autoVerify: Android haal /.well-known/assetlinks.json van
                 albei gashere af en kyk of die app se ondertekensleutel daarin
                 staan. Daardie lêer bestaan reeds (public/.well-known, uit die
                 TWA se tyd). Slaag dit nie, maak die skakel steeds in die
                 BLAAIER oop — niks breek nie, dit is net nie die app nie.

                 Die app gaan self na die skakel se pad: Capacitor laai altyd
                 server.url. Sien `appBestemming` in src/data/inheemsBrug.js.

                 GEEN /api, /privaatheid of prent-paaie nie — net bladsye wat
                 die app WYS. /go (die installeerblad) gaan binne die app na
                 die tuisblad. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.dewaldscheepers.com" />
                <data android:host="dewaldscheepers.com" />
                <data android:path="/" />
                <data android:pathPrefix="/hoop/" />
                <data android:pathPrefix="/bid/" />
                <data android:pathPrefix="/reels" />
                <data android:pathPrefix="/reel/" />
                <data android:pathPrefix="/boek" />
                <data android:pathPrefix="/sorg" />
                <data android:pathPrefix="/english" />
                <data android:pathPrefix="/volg-jesus" />
                <data android:pathPrefix="/vj" />
                <data android:pathPrefix="/go" />
                <data android:pathPrefix="/steun" />
                <data android:pathPrefix="/support" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Hoe die oggendkennisgewing lyk.

             Sonder hierdie twee reels neem Android die LANCEERIKOON en maak
             'n silhoeet daarvan vir die statusbalk. Ons ikoon is 'n vol
             prentjie, en 'n vol prentjie word 'n grys blok. Die reel is dat
             'n statusbalk-ikoon net wit-op-deursigtig mag wees; daarom
             ic_stat_hoop.

             Die kleur is die tint agter die klein ikoon in die uitgetrekte
             kennisgewing. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_hoop" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorPrimary" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Vanaf Android 13 is dit nie meer genoeg om net 'n kennisgewing te
         stuur nie — die mens moet dit toestaan, met dieselfde soort venster
         as vir die kamera. Sonder hierdie reel word daar nooit gevra nie en
         val elke kennisgewing stilweg op die vloer.

         Dit is wat die vorige weergawe van hierdie app se sonde was: die
         toestemming het bestaan, maar dit was die BLAAIER s'n, nie ons s'n
         nie, en Samsung Internet het dit nooit oorhandig nie. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Die mikrofoon, vir Dra Mekaar se stemopname en die admin se opname.
         Capacitor se WebView vra dit self wanneer die bladsy getUserMedia
         roep (BridgeWebChromeClient.onPermissionRequest) — maar Android
         weier 'n toestemming wat nie HIER staan nie, stilweg, en dan doen die
         opname-knoppie niks. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Die stemboodskap speel voort met die SKERM AF. Dewald, 20 Oktober
         2026: "If i press play and screen eventually goes black after few sec
         it stops playing." Android vries 'n app sonder 'n voorgronddiens
         sodra die skerm afgaan; Chrome het een, ons WebView nie. Die diens kom
         van @capgo/capacitor-media-session (MediaSessionService, tipe
         mediaPlayback) en loop net terwyl klank speel of gepouseer is.

         Sy eie manifest verklaar net FOREGROUND_SERVICE. Vanaf Android 14 eis
         startForeground(..., MEDIA_PLAYBACK) OOK hierdie tweede een — sonder
         dit gooi die stelsel 'n SecurityException en die app val om op die
         oomblik dat 'n mens druk speel. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
</manifest>

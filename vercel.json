{
  "crons": [
    {
      "path": "/api/process-email-queue?secret=DaaglikseHoop2025Cron",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/send-bulk-email.js": { "maxDuration": 300 },
    "api/process-email-queue.js": { "maxDuration": 300 },
    "api/kinder-upload.js": { "maxDuration": 60, "memory": 1024 }
  },
  "routes": [
    {
      "src": "/sw\\.js",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    {
      "src": "/",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    {
      "src": "/index\\.html",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/go", "dest": "/go.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}

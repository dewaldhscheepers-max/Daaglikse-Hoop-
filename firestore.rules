rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone (authenticated or not) can write their own FCM token
    match /fcm_tokens/{token} {
      allow write: if true;
      allow read:  if false;
    }

    // Samsung Internet native Web Push subscriptions
    match /webPushSubscriptions/{id} {
      allow write: if true;
      allow read:  if false;
    }

    // Devotionals are read-only to all — written only via Firebase Console / Admin SDK
    match /devotionals/{date} {
      allow read:  if true;
      allow write: if false;
    }

    // Evening prayers — anyone can read, admin app writes directly
    match /aandgebede/{id} {
      allow read:  if true;
      allow write: if true;
    }

    // Likes — anyone can read and increment, nobody can delete
    match /likes/{id} {
      allow read:   if true;
      allow write:  if true;
    }

    // Prayer wall — anyone can read and create, nobody can edit/delete
    match /prayers/{id} {
      allow read:   if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Testimonies — anyone can read and create, update only for amenCount/likeCount
    match /testimonies/{id} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Counters — clients can read (for live display), only server writes
    match /counters/{id} {
      allow read:  if true;
      allow write: if false;
    }

    // Purchase records — written by server only, admin reads via console
    match /purchases/{id} {
      allow read:  if false;
      allow write: if false;
    }

    // Anonymous growth stats — anyone can increment, admin reads
    match /stats/{id} {
      allow read:  if true;
      allow write: if true;
    }

    // Voice note play counts per note
    match /plays/{id} {
      allow read:  if true;
      allow write: if true;
    }

    // Voice notes — read by all, written by admin only
    match /notes/{id} {
      allow read:  if true;
      allow write: if true;
    }

    // Books — read by all, written by admin only
    match /books/{id} {
      allow read:  if true;
      allow write: if true;
    }

    // App config — admin writes via panel, Luister reads
    match /config/{id} {
      allow read:  if true;
      allow write: if true;
    }

    // Bou die Ark se wereldwye ranglys.
    // Geen kliënt raak hieraan nie — nie lees nie en nie skryf nie. Die
    // enigste pad in en uit is /api/ark-ranglys, wat met die diensrekening
    // werk, die speler se ID-token verifieer en die lopie op
    // geloofwaardigheid toets voordat 'n punt tel.
    //
    // Firestore weier by verstek waar geen reel pas nie, dus is hierdie blok
    // nie wat die versameling toemaak nie — dit is klaar toe. Dit staan hier
    // sodat die bedoeling swart op wit is en niemand dit later per ongeluk
    // oopmaak nie.
    match /arkRanglys/{userId} {
      allow read:  if false;
      allow write: if false;
    }

    // Vrugtefees se twee ranglyste: die Oesmeesters (beste lopie ooit) en
    // Vandag se Oes (almal op dieselfde bord).
    //
    // Net soos by arkRanglys raak geen klient hieraan nie. Die enigste pad
    // in en uit is /api/vrugtefees-ranglys, wat die speler se ID-token
    // verifieer en — anders as die Ark — die hele lopie OORSPEEL met
    // dieselfde enjin voordat 'n punt tel. Die klient stuur nie eens sy
    // puntetelling nie; die bediener bereken dit self.
    //
    // Firestore weier klaar waar geen reel pas nie. Hierdie blokke staan
    // hier sodat die bedoeling swart op wit is en niemand dit later per
    // ongeluk oopmaak nie.
    match /vfOesmeesters/{userId} {
      allow read:  if false;
      allow write: if false;
    }
    match /vfDagoes/{userId} {
      allow read:  if false;
      allow write: if false;
    }
    // Die Tuinreis se bord: hoe ver elke speler gevorder het. Elke fase se
    // saad staan in die bediener se eie data, dus bou hy die bord self en
    // speel die ingestuurde skuiwe oor. Net 'n fase wat WERKLIK klaargemaak
    // is, tel.
    match /vfTuinreis/{userId} {
      allow read:  if false;
      allow write: if false;
    }

    // ── Pastorale Sorg ──
    //
    // Hierdie is die enigste data in die hele app wat mense se mishandeling,
    // hul selfmoordgedagtes en hul huwelike dra. Geen kliënt raak enigiets
    // hier aan nie — nie lees nie en nie skryf nie. Die enigste pad in en uit
    // is /api/sorg-*, met die diensrekening en die admin-geheim.
    //
    // Firestore weier klaar waar geen reel pas nie. Hierdie blokke staan hier
    // sodat die bedoeling swart op wit is en niemand dit later per ongeluk
    // oopmaak nie. As iemand ooit 'allow read: if true' hier bo-op sit, lees
    // die hele internet 'n vrou se beskrywing van haar mishandeling.
    match /sorg_inkomend/{id} {
      allow read:  if false;
      allow write: if false;
    }
    match /sorg_config/{id} {
      allow read:  if false;
      allow write: if false;
    }
    match /sorg_tellers/{dag} {
      allow read:  if false;
      allow write: if false;
    }
    match /sorg_videos/{id} {
      allow read:  if false;
      allow write: if false;
    }
    // Die openbare muur: net wat 'n MENS goedgekeur en geredigeer het, kom
    // hier — en dit kom hier deur die bediener, nooit van 'n kliënt af nie.
    match /sorg_muur/{id} {
      allow read:  if false;
      allow write: if false;
    }
    // "Ek dra dit saam met jou" — een klein dokument per toestel per plasing,
    // sodat een mens een keer tel. Ook dit loop deur die bediener.
    match /sorg_saam/{id} {
      allow read:  if false;
      allow write: if false;
    }
    // Woorde van ondersteuning onder 'n storie. Party WAG vir Dewald se oog —
    // dit is die hele punt van die veld `status`. Sou 'n klient hier kon
    // lees, sou hy juis die woorde sien wat NOG NIE goedgekeur is nie, en
    // sou hy kon skryf, sou hy sy eie woord op 'wys' kon sit en die
    // hersiening heeltemal omseil. Alles loop deur die bediener.
    match /sorg_woorde/{id} {
      allow read:  if false;
      allow write: if false;
    }
    // Die perk op raaipogings by die admin se slot. Sou 'n klient hieraan kon
    // skryf, kon hy sy eie teller op nul sit en onbeperk raai.
    match /sorg_slot/{id} {
      allow read:  if false;
      allow write: if false;
    }

    // Blote getalle: tellers/toestemming en tellers/sorg. Geen naam, geen
    // toestel-id, niks wat na 'n mens teruglei nie — maar 'n kliënt raak
    // steeds nie daaraan nie. Hulle word deur die diensrekening geskryf
    // (api/tel-toestemming.js, api/tel-sorg.js), wat hierdie reels omseil.
    // Sonder hierdie blok geld dieselfde weiering by verstek; dit staan hier
    // sodat niemand later dink daar is 'n gaping nie.
    /* VOLG JESUS. Albei versamelings loop NET deur die Vercel-funksies met die
       diensrekening — die kliënt mag nooit direk daaraan raak nie.

       volgJesusVersoeke dra mense se name en kontakbesonderhede. 'n Kliënt wat
       dit kon lees, sou 'n lys kry van almal wat gevra het om oor doop te
       praat. */
    match /volgJesusWeke/{id}    { allow read: if false; allow write: if false; }
    match /volgJesusVersoeke/{id} { allow read: if false; allow write: if false; }

    match /tellers/{id} {
      allow read:  if false;
      allow write: if false;
    }

    /* ── VOLG JESUS · groepe en groepchat ──────────────────────────────
     *
     * Dit is die EERSTE plek in hierdie kodebasis waar 'n reel vra WIE die
     * leser is. Alles tot dusver was of heeltemal oop (prayers, notes) of
     * heeltemal toe (sorg_*).
     *
     * Die sekuriteit staan HIER, nie in die UI nie. Dewald se ss50: 'n mens
     * in groep A mag nooit groep B se data kry deur 'n id in 'n URL te
     * verander nie. Firestore dwing dit af; die skerm kan dit nie.
     *
     * Die truuk is dat 'n lid se dokumentnaam SY UID is. Dan is "is jy 'n
     * lid" een goedkoop `exists()`, en dit kan nie vervals word nie —
     * `request.auth.uid` kom van Firebase se geverifieerde token, nooit uit
     * die versoek se liggaam nie.
     *
     * Wat 'n KLIENT mag: sy groep lees, 'n boodskap skryf, sy eie boodskap
     * uitvee, sy eie leesmerk stel. Niks anders nie.
     *
     * Wat NET DIE BEDIENER mag (api/vj-groep.mjs met die diensrekening):
     * die groep self skep en verander, en lidmaatskap. Niemand maak homself
     * 'n fasiliteerder deur 'n dokument te skryf nie. */
    match /vjGroepe/{groepId} {

      function myLid() {
        return get(/databases/$(database)/documents/vjGroepe/$(groepId)/lede/$(request.auth.uid)).data;
      }
      function isLid() {
        return request.auth != null
          && exists(/databases/$(database)/documents/vjGroepe/$(groepId)/lede/$(request.auth.uid))
          && myLid().status == 'aktief';
      }
      function isFasiliteerder() {
        return isLid() && myLid().rol == 'fasiliteerder';
      }

      // Die groep se eie dokument: 'n lid lees dit, niemand skryf dit.
      allow read:  if isLid();
      allow write: if false;

      /* Lidmaatskap. 'n Lid sien wie in sy groep is (§16 wys die aantal en die
         fasiliteerder se naam). Skryf gaan ALTYD deur die bediener — aansluit,
         verlaat, verwyder, en rol. */
      match /lede/{uid} {
        allow read:  if isLid();
        allow write: if false;
      }

      /* Die boodskappe.
       *
       * `uid` MOET `request.auth.uid` wees. Dit is die reel wat keer dat
       * iemand namens 'n ander praat — die naam op die skerm kom uit die
       * boodskap, en sonder hierdie reel kon enigiemand 'n boodskap plaas wat
       * lyk of die fasiliteerder dit gese het.
       *
       * `teks` is PLAIN TEXT en hoogstens 4 000 karakters (§51). Firestore
       * tel Unicode-karakters, nie grepe nie, dus is die perk dieselfde as die
       * een in volgJesusGroep.js.
       *
       * `geskep` moet die BEDIENER se tyd wees. 'n Kliënt wat sy eie tyd kies,
       * kan 'n boodskap bo-aan die gesprek vasspeld of hom in die verlede
       * versteek. */
      match /boodskappe/{boodskapId} {
        allow read: if isLid();

        allow create: if isLid()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.teks is string
          && request.resource.data.teks.size() > 0
          && request.resource.data.teks.size() <= 4000
          && request.resource.data.naam is string
          && request.resource.data.naam.size() <= 30
          && request.resource.data.geskep == request.time
          && request.resource.data.uitgevee == false;

        /* Verander mag NET uitvee wees, en net jou eie — of die fasiliteerder
           s'n, wat sy eie groep modereer. Die teks self word nooit herskryf
           nie: 'n gesprek waarin woorde agterna verander, is nie 'n gesprek
           nie. */
        allow update: if isLid()
          && (resource.data.uid == request.auth.uid || isFasiliteerder())
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['uitgevee', 'uitgeveeOp'])
          && request.resource.data.uitgevee == true;

        // Niks word ooit werklik vernietig nie — dan kan 'n mens nie modereer.
        allow delete: if false;
      }

      /* Jou eie leesmerk. Net joune, en dit kan niks anders raak nie. */
      match /lees/{uid} {
        allow read, write: if request.auth != null
          && request.auth.uid == uid
          && isLid();
      }
    }

    /* Waar 'n mens hoort. Hy lees NET sy eie; die bediener skryf dit.
       Dit is 'n gemak sodat 'n foon sy groep terugkry na 'n herinstallasie —
       die WAARHEID oor lidmaatskap staan in vjGroepe/{id}/lede/{uid}. */
    match /vjGebruikers/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    /* Hoeveel keer iemand 'n groepkode geraai het. Niemand lees dit nie —
       ook nie die mens self nie, want dan weet hy hoeveel pogings oor is. */
    match /vjPogings/{uid} {
      allow read:  if false;
      allow write: if false;
    }

    // Vredepad Top 5 leaderboard
    match /leaderboard/{userId} {
      allow read: if true;
      allow create: if request.resource.data.consent == true
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.level is number
        && request.resource.data.score is number;
      allow update: if (
        request.resource.data.level > resource.data.level
        || (request.resource.data.level == resource.data.level
            && request.resource.data.score >= resource.data.score)
      );
    }
  }
}

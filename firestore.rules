rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone (authenticated or not) can write their own FCM token
    match /fcm_tokens/{token} {
      allow write: if true;
      allow read:  if false; // only Cloud Functions read this
    }

    // Devotionals are read-only to all — written only via Firebase Console / Admin SDK
    match /devotionals/{date} {
      allow read:  if true;
      allow write: if false;
    }

    // Prayer wall — anyone can read and create, nobody can edit/delete
    match /prayers/{id} {
      allow read:   if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone (authenticated or not) can write their own FCM token
    match /fcm_tokens/{token} {
      allow write: if true;
      allow read:  if false;
    }

    // Samsung Internet native Web Push subscriptions
    match /webPushSubscriptions/{id} {
      allow write: if true;
      allow read:  if false;
    }

    // Devotionals are read-only to all — written only via Firebase Console / Admin SDK
    match /devotionals/{date} {
      allow read:  if true;
      allow write: if false;
    }

    // Evening prayers — anyone can read, admin app writes directly
    match /aandgebede/{id} {
      allow read:  if true;
      allow write: if true;
    }

    // Likes — anyone can read and increment, nobody can delete
    match /likes/{id} {
      allow read:   if true;
      allow write:  if true;
    }

    // Prayer wall — anyone can read and create, nobody can edit/delete
    match /prayers/{id} {
      allow read:   if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Testimonies — anyone can read and create, update only for amenCount/likeCount
    match /testimonies/{id} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Counters — clients can read (for live display), only server writes
    match /counters/{id} {
      allow read:  if true;
      allow write: if false;
    }

    // Purchase records — written by server only, admin reads via console
    match /purchases/{id} {
      allow read:  if false;
      allow write: if false;
    }

    // Anonymous growth stats — anyone can increment, admin reads
    match /stats/{id} {
      allow read:  if true;
      allow write: if true;
    }

    // Voice note play counts per note
    match /plays/{id} {
      allow read:  if true;
      allow write: if true;
    }

    // Voice notes — read by all, written by admin only
    match /notes/{id} {
      allow read:  if true;
      allow write: if true;
    }

    // Books — read by all, written by admin only
    match /books/{id} {
      allow read:  if true;
      allow write: if true;
    }

    // App config — admin writes via panel, Luister reads
    match /config/{id} {
      allow read:  if true;
      allow write: if true;
    }

    // Vredepad Top 5 leaderboard
    match /leaderboard/{userId} {
      allow read: if true;
      allow create: if request.resource.data.consent == true
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.level is number
        && request.resource.data.score is number;
      allow update: if (
        request.resource.data.level > resource.data.level
        || (request.resource.data.level == resource.data.level
            && request.resource.data.score >= resource.data.score)
      );
    }
  }
}
